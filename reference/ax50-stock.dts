	cpuclocks {
		compatible = "lantiq,scaling-frequencies";

		cpuclocks@0 {
			status = "disabled";
			lantiq,cpuclocks = <0x23c34600 0x23c34600 0x23c34600 0x8f0d180>;
			lantiq,threshold_dp = <0x01 0x01 0x01 0x65>;
			lantiq,poll_period = <0x0b>;
		};

		cpuclocks@1 {
			status = "okay";
			lantiq,cpuclocks = <0x2faf0800 0x2faf0800 0x23c34600 0x8f0d180>;
			lantiq,threshold_dp = <0x01 0x01 0x01 0x65>;
			lantiq,poll_period = <0x0b>;
		};

		cpuclocks@2 {
			status = "disabled";
			lantiq,cpuclocks = <0x3b9aca00 0x27bc86aa 0x13de4355 0x9ef21aa>;
			lantiq,threshold_dp = <0x01 0x01 0x01 0x65>;
			lantiq,poll_period = <0x0b>;
		};

		cpuclocks@3 {
			status = "disabled";
			lantiq,cpuclocks = <0x47868c00 0x2faf0800 0x23c34600 0x8f0d180>;
			lantiq,threshold_dp = <0x01 0x01 0x01 0x65>;
			lantiq,poll_period = <0x0b>;
		};
