			#interrupt-cells = <0x02>;
			interrupt-parent = <0x01>;
			interrupts = <0xb4>;
			lantiq,bank = <0x00>;
			linux,phandle = <0x09>;
			phandle = <0x09>;

			nand_pins {
				status = "disabled";
