/dts-v1/;

/ {
	#address-cells = <0x01>;
	#size-cells = <0x01>;
	compatible = "lantiq,grx500\0lantiq,xrx500";
	model = "EASY350 ANYWAN (GRX350) Router model";

	aliases {
		serial0 = "/ssx4@16000000/serial@600000";
		serial1 = "/ssx4@16000000/serial@700000";
		dma0 = "/ssx4@16000000/dma@E00000";
		dma1 = "/ssx2@1a000000/dma@100000";
		dma2 = "/ssx2@1a000000/dma@200000";
		dma3 = "/ssx1@1c000000/dma@100000";
		dma4 = "/ssx1@1c000000/dma@200000";
		dma5 = "/ssx0@1E000000/dma@300000";
		dma6 = "/ssx0@1E000000/dma@400000";
		pcie0 = "/ssx3@18000000/pcie@900000";
		pcie1 = "/ssx3@18000000/pcie@400000";
		pcie2 = "/ssx3@18000000/pcie@E00000";
		usb0 = "/ssx2@1a000000/usb@300000";
		usb1 = "/ssx2@1a000000/usb@500000";
		spi1 = "/ssx4@16000000/spi@900000";
		xbar0 = "/ssx0@1E000000/xbar@1F00000";
		xbar1 = "/ssx1@1c000000/xbar@1F00000";
		xbar2 = "/ssx2@1a000000/xbar@1F00000";
		xbar6 = "/ssx6@12000000/xbar@1F00000";
		xbar7 = "/ssx7@a0000000/xbar@3000000";
		usb0_phy = "/ssx2@1a000000/phy@400000";
		usb1_phy = "/ssx2@1a000000/phy@600000";
	};

	cpus {

		cpu@0 {
			compatible = "mips,InterAptiv";
			default-OS = "LINUX";
		};

		cpu@1 {
			compatible = "mips,InterAptiv";
			default-OS = "LINUX";
		};

		cpu@2 {
			compatible = "mips,InterAptiv";
			default-OS = "LINUX";
		};

		cpu@3 {
			compatible = "mips,InterAptiv";
			default-OS = "MPEFW";
		};
	};

	ssx0@1E000000 {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		compatible = "lantiq,ssx\0simple-bus";
		reg = <0x1e000000 0x2000000>;
		ranges = <0x00 0x1e000000 0x2000000>;

		pmi@1100000 {
			compatible = "lantiq,pmi-xrx500";
			reg = <0x1100000 0x100>;
			interrupt-parent = <0x01>;
			interrupts = <0x66>;
		};

		eip97@100000 {
			compatible = "lantiq,crypto-xrx500";
			reg = <0x100000 0x100000>;
			interrupt-parent = <0x01>;
			interrupts = <0x61 0x62 0x63>;
		};

		dma@300000 {
			compatible = "lantiq,dma-grx500";
			reg = <0x300000 0x100000>;
			interrupt-parent = <0x01>;
			interrupts = <0x4d>;
			lantiq,dma-pkt-arb = <0x02>;
			lantiq,dma-burst = <0x10>;
			lantiq,dma-polling-cnt = <0x18>;
			lantiq,dma-chan-fc = <0x00>;
			lantiq,dma-desc-fod = <0x00>;
			lantiq,dma-desc-in-sram = <0x01>;
			lantiq,dma-drb = <0x00>;
			lantiq,dma-byte-en = <0x01>;
			lantiq,budget = <0x14>;
		};

		dma@400000 {
			status = "disabled";
			compatible = "lantiq,dma-grx500";
			reg = <0x400000 0x100000>;
			interrupt-parent = <0x01>;
			interrupts = <0x4e>;
			lantiq,dma-pkt-arb = <0x02>;
			lantiq,dma-burst = <0x10>;
			lantiq,dma-polling-cnt = <0x18>;
			lantiq,dma-chan-fc = <0x00>;
			lantiq,dma-desc-fod = <0x00>;
			lantiq,dma-desc-in-sram = <0x00>;
			lantiq,dma-drb = <0x00>;
		};

		cbm@700000 {
			status = "ok";
			compatible = "lantiq,cbm-xrx500";
			reg = <0x700000 0x1000 0x710000 0x10000 0x720000 0x4000 0x730000 0x14000 0x750000 0x400 0x750800 0x400 0x760000 0x10000 0x780000 0x20000 0x7c0000 0x30000 0x800000 0x100000 0x900000 0x100000 0x500000 0x100000>;
			interrupt-parent = <0x01>;
			interrupts = <0xb6 0xba 0xbb 0xbc 0xbd>;

			ltq_dqm_ports {

				DQ1 {
					lantiq,cbm-config = <0x01 0x22 0xff 0xff 0x05 0x01>;
				};

				DQ3 {
					lantiq,cbm-config = <0x03 0x24 0xff 0xff 0x04 0x01>;
				};

				DQ6 {
					lantiq,cbm-config = <0x06 0x10 0x02 0x01 0x01 0x02>;
				};

				DQ7 {
					lantiq,cbm-config = <0x07 0x11 0x02 0x02 0x01 0x02>;
				};

				DQ8 {
					lantiq,cbm-config = <0x08 0x12 0x02 0x03 0x01 0x02>;
				};

				DQ9 {
					lantiq,cbm-config = <0x09 0x13 0x02 0x04 0x01 0x02>;
				};

				DQ10 {
					lantiq,cbm-config = <0x0a 0x14 0x02 0x05 0x01 0x02>;
				};

				DQ11 {
					lantiq,cbm-config = <0x0b 0x15 0x02 0x06 0x01 0x02>;
				};

				DQ12 {
					lantiq,cbm-config = <0x0c 0x16 0x02 0x09 0x01 0x02>;
				};

				DQ13 {
					lantiq,cbm-config = <0x0d 0x17 0x02 0x0a 0x01 0x02>;
				};

				DQ14 {
					lantiq,cbm-config = <0x0e 0x18 0x02 0x0b 0x01 0x02>;
				};

				DQ15 {
					lantiq,cbm-config = <0x0f 0x19 0x02 0x0c 0x01 0x02>;
				};

				DQ16 {
					lantiq,cbm-config = <0x10 0x1a 0x02 0x0d 0x01 0x02>;
				};

				DQ17 {
					lantiq,cbm-config = <0x11 0x1b 0x02 0x0e 0x01 0x02>;
				};

				DQ19 {
					lantiq,cbm-config = <0x13 0x1c 0x01 0x0f 0x01 0x02>;
				};

				DQ20 {
					lantiq,cbm-config = <0x14 0x1d 0x01 0x05 0x01 0x02>;
				};

				DQ21 {
					lantiq,cbm-config = <0x15 0x1e 0x01 0x06 0x01 0x02>;
				};

				DQ22 {
					lantiq,cbm-config = <0x16 0x29 0x01 0x0b 0x01 0x02>;
				};

				DQ18 {
					lantiq,cbm-config = <0x12 0x00 0x01 0x0d 0x01 0x02>;
				};

				DQ23 {
					lantiq,cbm-config = <0x17 0x1f 0xff 0xff 0x01 0x02>;
				};

				DQ24 {
					lantiq,cbm-config = <0x18 0x26 0xff 0xff 0x01 0x20>;
				};

				DQ25 {
					lantiq,cbm-config = <0x19 0x27 0xff 0xff 0x01 0x20>;
				};

				DQ26 {
					lantiq,cbm-config = <0x1a 0x28 0xff 0xff 0x01 0x20>;
				};

				DQ4 {
					lantiq,cbm-config = <0x04 0x20 0xff 0xff 0x01 0x20>;
				};

				DQ2 {
					lantiq,cbm-config = <0x02 0x23 0xff 0xff 0x02 0x01>;
				};

				DQ5 {
					lantiq,cbm-config = <0x05 0x25 0xff 0xff 0x01 0x02>;
				};
			};

			ltq_eqm_ports {

				EQ1 {
					lantiq,cbm-config = <0x00 0xff 0xff 0xff 0x02 0x02>;
				};

				EQ2 {
					lantiq,cbm-config = <0x01 0xff 0xff 0xff 0x03 0x02>;
				};

				EQ3 {
					lantiq,cbm-config = <0x02 0xff 0xff 0xff 0x04 0x02>;
				};

				EQ4 {
					lantiq,cbm-config = <0x03 0xff 0xff 0xff 0x05 0x02>;
				};

				EQ5 {
					lantiq,cbm-config = <0x05 0x02 0x0e 0x00 0x07 0x02>;
				};

				EQ5_1 {
					lantiq,cbm-config = <0x05 0x02 0x1e 0x01 0x07 0x02>;
				};

				EQ6 {
					lantiq,cbm-config = <0x06 0x02 0x0f 0x00 0x07 0x02>;
				};

				EQ6_1 {
					lantiq,cbm-config = <0x06 0x02 0x1f 0x01 0x07 0x02>;
				};

				EQ7 {
					lantiq,cbm-config = <0x07 0x01 0x00 0x00 0x08 0x02>;
				};

				EQ7_1 {
					lantiq,cbm-config = <0x07 0x01 0x10 0x01 0x08 0x02>;
				};

				EQ8 {
					lantiq,cbm-config = <0x08 0x01 0x0f 0x00 0x08 0x02>;
				};

				EQ8_1 {
					lantiq,cbm-config = <0x08 0x01 0x1f 0x01 0x08 0x02>;
				};

				EQ9 {
					lantiq,cbm-config = <0x09 0xff 0xff 0xff 0x09 0x02>;
				};

				EQ12 {
					lantiq,cbm-config = <0x0c 0x01 0x03 0x00 0x0b 0x400>;
				};

				EQ15 {
					lantiq,cbm-config = <0x0f 0xff 0xff 0xff 0x0a 0x20>;
				};
			};
		};

		mps@1107000 {
			compatible = "lantiq,xrx500-mps";
			reg = <0x1107000 0x400>;
			interrupt-parent = <0x01>;
			interrupts = <0x9a 0x9b>;
			lantiq,mbx = <0x02>;
		};

		mpsmbx@1200000 {
			reg = <0x1200000 0x200>;
			linux,phandle = <0x02>;
			phandle = <0x02>;
		};

		eth@a00000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "lantiq,xrx500-net";
			interrupt-parent = <0x01>;
			interrupts = <0x38 0x35>;
			lantiq,eth-rx-csum-offload = <0x01>;
			status = "ok";

			interface@0 {
				compatible = "lantiq,xrx500-pdi";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				reg = <0x01>;

				ethernet@0 {
					compatible = "lantiq,xrx500-pdi-port";
					reg = <0x01>;
					phy-mode = "rgmii";
				};
			};

			interface@1 {
				compatible = "lantiq,xrx500-pdi";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				reg = <0x01>;

				ethernet@1 {
					compatible = "lantiq,xrx500-pdi-port";
					reg = <0x02>;
					interrupt-parent = <0x01>;
					interrupts = <0x78>;
					phy-mode = "rgmii";
					phy-handle = <0x03>;
				};
			};

			interface@2 {
				compatible = "lantiq,xrx500-pdi";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				reg = <0x02>;

				ethernet@2 {
					compatible = "lantiq,xrx500-pdi-port";
					reg = <0x03>;
					interrupt-parent = <0x01>;
					interrupts = <0x79>;
					phy-mode = "rgmii";
					phy-handle = <0x04>;
				};
			};

			interface@3 {
				compatible = "lantiq,xrx500-pdi";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				reg = <0x03>;

				ethernet@3 {
					compatible = "lantiq,xrx500-pdi-port";
					reg = <0x04>;
					interrupt-parent = <0x01>;
					interrupts = <0x86>;
					phy-mode = "rgmii";
					phy-handle = <0x05>;
				};
			};

			interface@4 {
				compatible = "lantiq,xrx500-pdi";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				reg = <0x04>;

				ethernet@4 {
					compatible = "lantiq,xrx500-pdi-port";
					reg = <0x05>;
					interrupt-parent = <0x01>;
					interrupts = <0x87>;
					phy-mode = "rgmii";
					phy-handle = <0x06>;
				};
			};

			interface@5 {
				compatible = "lantiq,xrx500-pdi";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				reg = <0x05>;

				ethernet@5 {
					compatible = "lantiq,xrx500-pdi-port";
					reg = <0x07>;
				};
			};

			interface@6 {
				compatible = "lantiq,xrx500-pdi";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				reg = <0x06>;
				lantiq,wan;

				ethernet@6 {
					compatible = "lantiq,xrx500-pdi-port";
					reg = <0x01>;
					interrupt-parent = <0x01>;
					interrupts = <0x77>;
					phy-mode = "rgmii";
					phy-handle = <0x07>;
				};
			};
		};

		mdio@0 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "lantiq,xrx500-mdio";

			ethernet-phy@2 {
				reg = <0x02>;
				compatible = "lantiq,phy11g\0ethernet-phy-ieee802.3-c22";
				linux,phandle = <0x03>;
				phandle = <0x03>;
			};

			ethernet-phy@3 {
				reg = <0x03>;
				compatible = "lantiq,phy11g\0ethernet-phy-ieee802.3-c22";
				linux,phandle = <0x04>;
				phandle = <0x04>;
			};

			ethernet-phy@4 {
				reg = <0x04>;
				compatible = "lantiq,phy11g\0ethernet-phy-ieee802.3-c22";
				linux,phandle = <0x05>;
				phandle = <0x05>;
			};

			ethernet-phy@5 {
				reg = <0x05>;
				compatible = "lantiq,phy11g\0ethernet-phy-ieee802.3-c22";
				linux,phandle = <0x06>;
				phandle = <0x06>;
			};
		};

		mdio@1 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "lantiq,xrx500-mdio-pae";

			ethernet-phy@1 {
				reg = <0x01>;
				compatible = "lantiq,phy11g\0ethernet-phy-ieee802.3-c22";
				linux,phandle = <0x07>;
				phandle = <0x07>;
			};
		};

		xbar@1F00000 {
			compatible = "lantiq,ngi-ssx-grx500";
			reg = <0x1f00000 0x100000>;
		};
	};

	ssx1@1c000000 {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		compatible = "lantiq,ssx\0simple-bus";
		reg = <0x1c000000 0x2000000>;
		ranges = <0x00 0x1c000000 0x2000000>;

		gswitch@000000 {
			compatible = "lantiq,xrx500-gswapi\0lantiq,xway-gswapi";
			reg = <0x00 0x3000>;
			lantiq,gsw-devid = <0x00>;
		};

		dma@100000 {
			compatible = "lantiq,dma-grx500";
			reg = <0x100000 0x100000>;
			interrupt-parent = <0x01>;
			interrupts = <0x4b>;
			lantiq,dma-pkt-arb = <0x02>;
			lantiq,dma-burst = <0x10>;
			lantiq,dma-polling-cnt = <0x18>;
			lantiq,dma-chan-fc = <0x01>;
			lantiq,dma-desc-fod = <0x01>;
			lantiq,dma-desc-in-sram = <0x00>;
			lantiq,dma-drb = <0x00>;
			lantiq,dma-byte-en = <0x01>;
			lantiq,budget = <0x14>;
		};

		dma@200000 {
			compatible = "lantiq,dma-grx500";
			reg = <0x200000 0x100000>;
			interrupt-parent = <0x01>;
			interrupts = <0x4c>;
			lantiq,dma-pkt-arb = <0x02>;
			lantiq,dma-burst = <0x10>;
			lantiq,dma-polling-cnt = <0x18>;
			lantiq,dma-chan-fc = <0x00>;
			lantiq,dma-desc-fod = <0x01>;
			lantiq,dma-desc-in-sram = <0x01>;
			lantiq,dma-drb = <0x00>;
			lantiq,dma-byte-en = <0x01>;
			lantiq,budget = <0x14>;
		};

		xbar@1F00000 {
			compatible = "lantiq,ngi-ssx-grx500";
			reg = <0x1f00000 0x100000>;
		};
	};

	ssx2@1a000000 {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		compatible = "lantiq,ssx\0simple-bus";
		reg = <0x1a000000 0x2000000>;
		ranges = <0x00 0x1a000000 0x2000000>;

		gswitch@000000 {
			compatible = "lantiq,xrx500-gswapi\0lantiq,xway-gswapi";
			reg = <0x00 0x3000>;
			lantiq,gsw-devid = <0x01>;
		};

		dma@100000 {
			compatible = "lantiq,dma-grx500";
			reg = <0x100000 0x100000>;
			interrupt-parent = <0x01>;
			interrupts = <0x49>;
			lantiq,dma-pkt-arb = <0x02>;
			lantiq,dma-burst = <0x10>;
			lantiq,dma-polling-cnt = <0x6c>;
			lantiq,dma-chan-fc = <0x01>;
			lantiq,dma-desc-fod = <0x01>;
			lantiq,dma-desc-in-sram = <0x01>;
			lantiq,dma-drb = <0x00>;
			lantiq,dma-byte-en = <0x01>;
			lantiq,budget = <0x14>;
			lantiq,dma-lab-cnt = <0x02>;
		};

		dma@200000 {
			compatible = "lantiq,dma-grx500";
			reg = <0x200000 0x100000>;
			interrupt-parent = <0x01>;
			interrupts = <0x4a>;
			lantiq,dma-pkt-arb = <0x02>;
			lantiq,dma-burst = <0x10>;
			lantiq,dma-polling-cnt = <0x18>;
			lantiq,dma-chan-fc = <0x00>;
			lantiq,dma-desc-fod = <0x01>;
			lantiq,dma-desc-in-sram = <0x00>;
			lantiq,dma-drb = <0x00>;
			lantiq,dma-byte-en = <0x00>;
			lantiq,budget = <0x14>;
		};

		usb@300000 {
			compatible = "lantiq,dwc3-core";
			reg = <0x300000 0x100000>;
			interrupt-parent = <0x01>;
			interrupts = <0x3e>;
			phys = <0x08>;
			status = "ok";
			vbus-gpio = <0x09 0x0e 0x00>;
		};

		phy@400000 {
			compatible = "lantiq,dwc3-phy";
			reg = <0x400000 0x100000>;
			linux,phandle = <0x08>;
			phandle = <0x08>;
		};

		usb_oc@0 {
			compatible = "lantiq,usb-oc";
			interrupt-parent = <0x01>;
			interrupts = <0x3d>;
			overcurrent-gpio = <0x0e>;
			node-name = "pad";
		};

		usb@500000 {
			compatible = "lantiq,dwc3-xrx500\0lantiq,dwc3-core";
			reg = <0x500000 0x100000>;
			interrupt-parent = <0x01>;
			interrupts = <0x5b>;
			phys = <0x0a>;
			status = "ok";
			vbus-gpio = <0x09 0x02 0x00>;
		};

		phy@600000 {
			compatible = "lantiq,dwc3-phy";
			reg = <0x600000 0x100000>;
			linux,phandle = <0x0a>;
			phandle = <0x0a>;
		};

		usb_oc@1 {
			compatible = "lantiq,usb-oc";
			interrupt-parent = <0x01>;
			interrupts = <0x3a>;
			overcurrent-gpio = <0x02>;
			node-name = "pad";
		};

		xbar@1F00000 {
			compatible = "lantiq,ngi-ssx-grx500";
			reg = <0x1f00000 0x100000>;
		};
	};

	ssx3@18000000 {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		compatible = "lantiq,ssx\0simple-bus";
		reg = <0x18000000 0xa8000000>;
		ranges = <0x00 0x18000000 0xa8000000>;

		pcie@900000 {
			status = "ok";
			compatible = "lantiq,pcie-xrx500";
			device_type = "pci";
			#address-cells = <0x03>;
			#size-cells = <0x02>;
			reg = <0x900000 0x100000 0xa3000000 0x800000 0x800000 0x100000 0x500000 0x100000 0x600000 0x100000 0x700000 0x100000>;
			reg-names = "csr\0cfg\0app\0phy\0msi\0pic";
			interrupt-parent = <0x01>;
			interrupts = <0x88 0x89 0x8a 0x8b 0x8c 0x8d 0x8e 0x8f 0xa0>;
			interrupt-names = "msi0\0msi1\0msi2\0msi3\0msi4\0msi5\0msi6\0msi7\0ir";
			#interrupt-cells = <0x01>;
			interrupt-map-mask = <0x00 0x00 0x00 0x07>;
			interrupt-map = <0x00 0x00 0x00 0x01 0x01 0x90 0x00 0x00 0x00 0x02 0x01 0x91 0x00 0x00 0x00 0x03 0x01 0x92 0x00 0x00 0x00 0x04 0x01 0x93>;
			ranges = <0x2000000 0x00 0xa0000000 0xa0000000 0x00 0x3000000 0x1000000 0x00 0xa3800000 0xa3800000 0x00 0x100000>;
			resets = <0x0b 0x0c>;
			reset-names = "phy";
			lantiq,inbound-shift = <0x05>;
			lantiq,outbound-shift = <0x04>;
			lantiq,clkout = <0x16>;
			lantiq,rst-high-active = <0x00>;
			lantiq,rst-interval = <0xc8>;
			lantiq,inbound-swap = <0x01>;
			lantiq,outbound-swap = <0x00>;
			lantiq,phy-mode = <0x05>;
			reset-gpio = <0x0c 0x0b 0x00>;
		};

