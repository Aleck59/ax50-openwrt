				partition@7Ec0000 {
					label = "res";
					reg = <0x7ec0000 0x140000>;
				};
			};
		};

		i2c@a00000 {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "ok";
			compatible = "lantiq,lantiq-i2c";
			reg = <0xa00000 0x10000>;
			interrupt-parent = <0x01>;
			interrupts = <0x29 0x28 0x1f 0x2c>;
			clock-frequency = <0x186a0>;

			ina219@40 {
				compatible = "ti,ina219";
				reg = <0x40>;
				shunt-resistor = <0x2710>;
				rail-name = "PWR_12V";
				calibration-factor = <0x2710000>;
			};

			tps65273@62 {
				compatible = "ti,tps65273";
				reg = <0x62>;

				regulators {

					dcdc2 {
						regulator-name = "1V15VDD";
						regulator-always-on;
						regulator-min-microvolt = <0xdbba0>;
						regulator-max-microvolt = <0x124f80>;
						vout-slew-rate = <0x00>;
						vout-psm-mode = <0x00>;
