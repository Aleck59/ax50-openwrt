		mcpy@2800000 {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			compatible = "lantiq,mcpy-xrx500";
			reg = <0x2800000 0x800000>;
			interrupt-parent = <0x01>;
			interrupts = <0xc8 0xc9 0xca 0xcb 0xcc 0xcd 0xce 0xcf 0xd0 0xd1 0xd2 0xd3 0xd4 0xd5 0xd6 0xd7 0xd8>;
			interrupt-names = "yld0\0yld1\0yld2\0yld3\0yld4\0yld5\0yld6\0yld7\0irq0\0irq1\0irq2\0irq3\0irq4\0irq5\0irq6\0irq7";
