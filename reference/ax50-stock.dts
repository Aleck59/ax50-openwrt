				linux,phandle = <0x0d>;
				phandle = <0x0d>;

				i2c {
					lantiq,groups = "i2c";
					lantiq,function = "i2c";
					status = "ok";
				};

				nand {
					lantiq,groups = "nand cle\0nand ale\0nand rd\0nand rdy\0nand d0\0nand d1\0nand d2\0nand d3\0nand d4\0nand d5\0nand d6\0nand d7\0nand cs1\0nand wr\0nand wp";
					lantiq,function = "ebu";
					status = "ok";
				};

				conf {
					lantiq,pins = "io32\0io33";
					lantiq,open-drain = <0x01>;
				};
			};

			spi0 {
				status = "disabled";

				spi0 {
					lantiq,groups = "spi0\0spi0_cs1";
					lantiq,function = "spi0";
				};
			};

			tdm {

				tdm {
					lantiq,groups = "tdm";
					lantiq,function = "tdm";
				};
			};
		};

