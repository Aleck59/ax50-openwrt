		localbus@0 {
			#address-cells = <0x02>;
			#size-cells = <0x01>;
			ranges = <0x00 0x00 0x1c00000 0xfffff>;
			compatible = "lantiq,localbus\0simple-bus";

			nand-parts@0 {
				compatible = "gen_nand\0lantiq,nand-xway";
				lantiq,cs = <0x01>;
				bank-width = <0x02>;
				reg = <0x00 0x00 0x100000>;
