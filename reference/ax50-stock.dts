			#address-cells = <0x01>;
			#size-cells = <0x00>;

			ltq-spinand@1 {
				status = "disabled";
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				reg = <0x01 0x01>;
				compatible = "lantiq,generic-spinand";
				linux,mtd-name = "17c00000.nand-parts";
