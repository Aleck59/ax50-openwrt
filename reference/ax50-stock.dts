			ltq-spinand@0 {
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				reg = <0x00 0x01>;
				compatible = "lantiq,generic-spinand";
				linux,mtd-name = "17c00000.nand-parts";
				spi-max-frequency = <0xf4240>;

				partition@0 {
					label = "uboot";
