	gpio-keys-polled {
		compatible = "gpio-keys-polled";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		poll-interval = <0x64>;

		wifi {
			label = "wifi";
			gpios = <0x0c 0x04 0x01>;
			linux,code = <0xee>;
		};

		wps {
			label = "wps";
			gpios = <0x09 0x08 0x01>;
			linux,code = <0x211>;
		};

		reset {
			label = "reset";
			gpios = <0x09 0x16 0x01>;
			linux,code = <0x198>;
		};
	};

	gpio-leds {
		compatible = "gpio-leds";

		lan {
			label = "blue:lan";
			gpios = <0x09 0x09 0x00>;
			status = "ok";
		};

		usb_2 {
			label = "blue:usb_2";
			gpios = <0x09 0x0b 0x00>;
			status = "ok";
		};

		o_wan {
			label = "orange:internet";
			gpios = <0x09 0x06 0x00>;
			status = "ok";
		};

		b_wan {
			label = "blue:internet";
			gpios = <0x09 0x07 0x00>;
			status = "ok";
		};

		power {
			label = "blue:power";
			gpios = <0x09 0x15 0x00>;
			default-state = "on";
			status = "ok";
		};

		wlan_2g {
			label = "blue:wlan_2g";
			gpios = <0x09 0x01 0x00>;
			status = "ok";
		};

		wlan_5g {
			label = "blue:wlan_5g";
			gpios = <0x09 0x04 0x00>;
			status = "ok";
		};
	};

	chosen {
	};

	memory@0 {
		device_type = "memory";
		reg = <0x20000000 0x1e000000>;
	};

	mei@E116000 {
		compatible = "lantiq,mei-xrx300";
		reg = <0xe116000 0x100>;
		interrupts = <0x3f>;
	};

	phy-xrx500 {
		compatible = "lantiq,phy-xrx500";
		firmware = "lantiq/phy11g_ip_BE.bin";
		phy_id = [00 01 02 03 04];
		resets = <0x0b 0x1d 0x0b 0x1c 0x0b 0x1a 0x0b 0x19 0x0b 0x1f>;
		reset-names = "phy0\0phy1\0phy2\0phy3\0phy4";
	};

	gphy-fw {
		compatible = "lantiq,xway-phy-fw";
		fw-mode = "11G-FW";
		no_of_phys = <0x05>;
	};
};
