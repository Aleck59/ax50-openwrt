{
	"luci-app-netdata": {
		"description": "Grant access to Netdata service control",
		"read": {
			"file": {
				"/bin/pidof netdata": [ "exec" ]
			}
		},
		"write": {
			"file": {
				"/etc/init.d/netdata start": [ "exec" ],
				"/etc/init.d/netdata stop": [ "exec" ],
				"/etc/init.d/netdata enable": [ "exec" ],
				"/etc/init.d/netdata disable": [ "exec" ]
			}
		}
	}
}
