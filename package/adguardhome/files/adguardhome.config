config adguardhome 'config'
	# Запускать AdGuard Home. Первый запуск — мастер настройки на порту 3000:
	# http://192.168.1.1:3000
	option enabled '1'
	option config '/etc/adguardhome.yaml'
	option workdir '/etc/adguardhome'
	# Отправлять DNS-запросы dnsmasq в AdGuard Home (порт DNS берётся из
	# /etc/adguardhome.yaml). Рекомендуемая схема: в мастере укажите для DNS
	# порт 5353, а dnsmasq оставьте на 53 — тогда сохраняются локальные имена
	# DHCP-клиентов, а вся фильтрация идёт через AdGuard Home.
	option dnsmasq_upstream '0'
