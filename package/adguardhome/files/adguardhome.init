#!/bin/sh /etc/rc.common
# AdGuard Home (procd)

START=60
STOP=10
USE_PROCD=1

PROG=/usr/bin/AdGuardHome

# Порт DNS из конфигурации AdGuard Home (секция dns: → port:)
agh_dns_port() {
	[ -f "$1" ] || return 1
	awk '/^dns:/ { d = 1; next } d && /^[^ #]/ { d = 0 } d && /^  port:/ { print $2; exit }' "$1"
}

# Включить/выключить пересылку DNS-запросов dnsmasq в AdGuard Home
agh_dnsmasq_sync() {
	local mode="$1" want port applied

	config_get_bool want config dnsmasq_upstream 0
	config_get cfg config config /etc/adguardhome.yaml
	applied="$(uci -q get adguardhome.config.applied_port)"
	port="$(agh_dns_port "$cfg")"

	[ "$mode" = start ] && [ "$want" = 1 ] && [ -n "$port" ] && [ "$port" != 53 ] || port=""
	[ "$port" = "$applied" ] && return 0

	if [ -n "$applied" ]; then
		uci -q del_list dhcp.@dnsmasq[0].server="127.0.0.1#$applied"
		uci -q delete dhcp.@dnsmasq[0].noresolv
		uci -q delete adguardhome.config.applied_port
	fi
	if [ -n "$port" ]; then
		uci -q add_list dhcp.@dnsmasq[0].server="127.0.0.1#$port"
		uci -q set dhcp.@dnsmasq[0].noresolv='1'
		uci -q set adguardhome.config.applied_port="$port"
	fi
	uci -q commit dhcp
	uci -q commit adguardhome
	/etc/init.d/dnsmasq reload >/dev/null 2>&1
}

start_service() {
	local enabled cfg wd

	config_load adguardhome
	config_get_bool enabled config enabled 0
	if [ "$enabled" != 1 ]; then
		agh_dnsmasq_sync stop
		return 0
	fi

	config_get cfg config config /etc/adguardhome.yaml
	config_get wd config workdir /etc/adguardhome
	mkdir -p "$wd"

	procd_open_instance
	# --no-check-update: бинарник лежит в squashfs, обновляется пакетом
	procd_set_param command "$PROG" -c "$cfg" -w "$wd" --no-check-update
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="16384 16384"
	procd_close_instance

	agh_dnsmasq_sync start
}

stop_service() {
	config_load adguardhome
	agh_dnsmasq_sync stop
}

service_triggers() {
	procd_add_reload_trigger adguardhome
}
