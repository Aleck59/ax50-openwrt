#!/usr/bin/lua
-- Proton2025 для LuCI 19.07 (ax50-openwrt): порт rpcd-модуля luci.proton-temp.
-- Датчики hwmon и thermal_zone (без дублей), пороги в /etc/config/proton2025.
-- Отличия от апстрима:
--   * exec-плагин живёт один вызов, поэтому пики хранятся в /tmp;
--   * добавлены радиомодули WAV600 (iw dev wlanN iwlwav gTemperature) —
--     в sysfs их температуры нет;
--   * интеграции с 5gmodem нет (такого пакета в прошивке нет).
-- Proton2025 Theme, Copyright 2025-2026 ChesterGoodiny. Apache-2.0.

local jsonc = require "luci.jsonc"
local nfs = require "nixio.fs"
-- в LuCI 19.07 Lua-биндинга uci нет; luci.model.uci работает через ubus
local uci = require "luci.model.uci"

local PEAKS = "/tmp/proton-temp-peaks.json"
local DEFAULT = { warm = 50, hot = 70, critical = 85 }

local function readfile(p)
	local s = nfs.readfile(p)
	return s and (s:gsub("^%s+", ""):gsub("%s+$", "")) or nil
end

local function load_peaks()
	local t = jsonc.parse(nfs.readfile(PEAKS) or "")
	return type(t) == "table" and t or {}
end

local function list(dir, pattern)
	local out = {}
	local it = nfs.dir(dir)
	if it then
		for name in it do
			if name:match(pattern) then out[#out + 1] = name end
		end
	end
	table.sort(out)
	return out
end

local function valid(t)
	local w, h, c = tonumber(t.warm), tonumber(t.hot), tonumber(t.critical)
	return w and h and c and w == math.floor(w) and h == math.floor(h) and c == math.floor(c)
		and w >= 0 and c <= 150 and w < h and h < c
end

local methods = {}

function methods.getThresholds()
	local c = uci.cursor()
	local t = {
		warm = tonumber(c:get("proton2025", "settings", "temp_threshold_warm") or DEFAULT.warm),
		hot = tonumber(c:get("proton2025", "settings", "temp_threshold_hot") or DEFAULT.hot),
		critical = tonumber(c:get("proton2025", "settings", "temp_threshold_critical") or DEFAULT.critical)
	}
	if not valid(t) then
		return { warm = DEFAULT.warm, hot = DEFAULT.hot, critical = DEFAULT.critical }
	end
	return t
end

function methods.setThresholds(args)
	local t = { warm = tonumber(args.warm), hot = tonumber(args.hot), critical = tonumber(args.critical) }
	if not valid(t) then
		return { success = false,
			error = "Thresholds must be whole numbers and satisfy 0 <= warm < hot < critical <= 150",
			thresholds = methods.getThresholds() }
	end
	local c = uci.cursor()
	if not c:get("proton2025", "settings") then
		c:section("proton2025", "theme", "settings", {})
	end
	c:set("proton2025", "settings", "temp_threshold_warm", tostring(t.warm))
	c:set("proton2025", "settings", "temp_threshold_hot", tostring(t.hot))
	c:set("proton2025", "settings", "temp_threshold_critical", tostring(t.critical))
	c:commit("proton2025")
	return { success = true, thresholds = t }
end

function methods.getSensors()
	local peaks = load_peaks()
	local sensors = {}

	local function add(name, temp, path, source)
		if not peaks[path] or temp > peaks[path] then peaks[path] = temp end
		sensors[#sensors + 1] = { name = name, temp = temp, peak = peaks[path], path = path, source = source }
	end

	local hwmonDev, hwmonPath = {}, {}
	for _, h in ipairs(list("/sys/class/hwmon", "^hwmon")) do
		local base = "/sys/class/hwmon/" .. h
		local devname = readfile(base .. "/name") or "hwmon"
		local found = false
		for _, f in ipairs(list(base, "^temp%d+_input$")) do
			local v = tonumber(readfile(base .. "/" .. f) or "")
			if v then
				local idx = f:match("^temp(%d+)_input$")
				add(readfile(base .. "/temp" .. idx .. "_label") or devname, v, base .. "/" .. f, "hwmon")
				found = true
			end
		end
		if found then
			local d = nfs.realpath(base .. "/device")
			local p = nfs.realpath(base)
			if d then hwmonDev[d] = true end
			if p then hwmonPath[p] = true end
		end
	end

	for _, z in ipairs(list("/sys/class/thermal", "^thermal_zone")) do
		local base = "/sys/class/thermal/" .. z
		local zp, zd = nfs.realpath(base), nfs.realpath(base .. "/device")
		local dup = (zp and hwmonDev[zp]) or (zd and hwmonDev[zd])
		if not dup and zp then
			for p in pairs(hwmonPath) do
				if p == zp or p:sub(1, #zp + 1) == zp .. "/" then dup = true break end
			end
		end
		local v = not dup and tonumber(readfile(base .. "/temp") or "")
		if v then
			add(readfile(base .. "/type") or "thermal", v, base, "thermal_zone")
		end
	end

	-- WAV600: температура по группам антенн, берём максимум (°C)
	for _, dev in ipairs(list("/sys/class/net", "^wlan%d+$")) do
		if nfs.access("/sys/class/net/" .. dev .. "/phy80211") then
			local f = io.popen("iw dev " .. dev .. " iwlwav gTemperature 2>/dev/null")
			local out = f and f:read("*a") or ""
			if f then f:close() end
			local max
			for n in (out:match(":(.*)$") or ""):gmatch("%d+") do
				n = tonumber(n)
				if n > 0 and n < 150 and (not max or n > max) then max = n end
			end
			if max then
				local fi = io.popen("iw dev " .. dev .. " info 2>/dev/null")
				local info = fi and fi:read("*a") or ""
				if fi then fi:close() end
				local freq = tonumber(info:match("%((%d+) MHz%)") or "")
				local name = (freq and freq > 4000) and "Wi-Fi 5 GHz" or "Wi-Fi 2.4 GHz"
				add(name, max * 1000, "wifi:" .. dev, "wifi")
			end
		end
	end

	nfs.writefile(PEAKS, jsonc.stringify(peaks))
	return { sensors = sensors }
end

function methods.resetPeaks()
	nfs.unlink(PEAKS)
	return { success = true }
end

function methods.getIntegrations()
	return { modem = false }
end

if arg[1] == "list" then
	io.write('{"getSensors":{},"resetPeaks":{},"getThresholds":{},' ..
		'"setThresholds":{"warm":32,"hot":32,"critical":32},"getIntegrations":{}}')
elseif arg[1] == "call" and methods[arg[2]] then
	local args = jsonc.parse(io.read("*a") or "") or {}
	io.write(jsonc.stringify(methods[arg[2]](type(args) == "table" and args or {})))
end
