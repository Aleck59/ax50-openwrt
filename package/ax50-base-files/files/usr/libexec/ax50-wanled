#!/bin/sh
# Светодиод «Интернет» (WAN) на штатном триггере netdev (как LAN и Wi-Fi):
#   нет кабеля в порту WAN       — не горит;
#   кабель есть, нет подключения — оранжевый;
#   есть маршрут по умолчанию    — синий (PPPoE, L2TP, DHCP, static).
# Горящий светодиод мигает при передаче данных через eth1 (link tx rx).
# Пересчёт — на ifup/ifdown любого интерфейса (hotplug.d/iface/30-ax50-wanled).

WAN_DEV=eth1
B=/sys/class/leds/blue:wan
O=/sys/class/leds/orange:wan

[ -d "$B" ] && [ -d "$O" ] || exit 0

led_off() {
	echo none > "$1/trigger"
	echo 0 > "$1/brightness"
}

led_wan() {
	local m
	grep -q '\[netdev\]' "$1/trigger" || echo netdev > "$1/trigger" 2>/dev/null || return
	echo "$WAN_DEV" > "$1/device_name"
	for m in link tx rx; do
		[ -e "$1/$m" ] && echo 1 > "$1/$m"
	done
	[ -e "$1/interval" ] && echo 50 > "$1/interval"
}

if [ -e /etc/ax50/leds-off ]; then
	led_off "$B"
	led_off "$O"
elif ip -4 route show 2>/dev/null | grep -q '^default ' ||
     ip -6 route show 2>/dev/null | grep -q '^default '; then
	led_off "$O"
	led_wan "$B"
else
	led_off "$B"
	led_wan "$O"
fi
exit 0
