#!/bin/sh
# Аппаратное ускорение PPA (GRX350: PAE + MPE) по настройкам /etc/config/ppa.
# Последовательность как в стоковой прошивке TP-Link AX50
# (preinit/05_init_interfaces_intel, init.d/hnat-start, sbin/config_ppa):
#   ppacmd init (порог пакетов), control --enable-lan/--enable-wan,
#   addlan (мост, порты, Wi-Fi) / addwan (eth1, PPPoE), включение PAE и MPE,
#   setppefp / setswfp; при подъёме интерфейсов — повторная регистрация.
#
#   ax50-ppa start | stop | register | status

. /lib/functions.sh

STATE=/var/run/ax50-ppa

ready() {
	[ -x /usr/sbin/ppacmd ] && grep -q '^ppa_api ' /proc/modules
}

accel() {
	[ -w "/proc/ppa/$1/accel" ] || return 0
	if [ "$2" = 1 ]; then echo enable; else echo disable; fi > "/proc/ppa/$1/accel"
}

add_if() {
	[ -e "/sys/class/net/$2" ] && ppacmd "add$1" -i "$2" >/dev/null 2>&1
	return 0
}
add_lan() { add_if lan "$1"; }
add_wan() { add_if wan "$1"; }

register() {
	local i wlan tunnels
	[ -e "$STATE" ] || return 0
	config_load ppa
	config_list_foreach global lan add_lan
	config_get_bool wlan global wlan 1
	if [ "$wlan" = 1 ]; then
		for i in /sys/class/net/wlan*; do add_lan "${i##*/}"; done
	fi
	config_list_foreach global wan add_wan
	config_get_bool tunnels global tunnels 1
	if [ "$tunnels" = 1 ]; then
		for i in /sys/class/net/pppoe-* /sys/class/net/l2tp-*; do add_wan "${i##*/}"; done
	fi
}

start() {
	local enabled threshold pae mpe hwfp swfp
	config_load ppa
	config_get_bool enabled global enabled 0
	[ "$enabled" = 1 ] || return 0
	ready || { logger -t ax50-ppa "нет ppacmd или модуля ppa_api"; return 1; }

	config_get threshold global threshold 3
	# Порог — ключом -n: файл (-f) ppacmd этой версии не разбирает —
	# cfg_names и INIT_CMD в ppacmd.c не совпадают по порядку, и
	# «tcp-threshold» даёт «error: invalid command - line 1»
	ppacmd init -n "$threshold" >/dev/null 2>&1 || {
		logger -t ax50-ppa "ppacmd init: ошибка"
		return 1
	}
	ppacmd control --enable-lan --enable-wan >/dev/null 2>&1
	touch "$STATE"
	register

	config_get_bool pae global pae 1
	config_get_bool mpe global mpe 1
	config_get_bool hwfp global hwfp 1
	config_get_bool swfp global swfp 1
	accel pae "$pae"
	accel mpe "$mpe"
	ppacmd setppefp -f "$hwfp" >/dev/null 2>&1
	ppacmd setswfp -f "$swfp" >/dev/null 2>&1
	logger -t ax50-ppa "ускорение включено (PAE $pae, MPE $mpe, HW $hwfp, SW $swfp, порог $threshold)"
}

stop() {
	[ -e "$STATE" ] || return 0
	rm -f "$STATE"
	ready && ppacmd exit >/dev/null 2>&1
	logger -t ax50-ppa "ускорение выключено"
}

status() {
	if [ -e "$STATE" ]; then echo "state: on"; else echo "state: off"; fi
	ready || { echo "ppa: not loaded"; return 0; }
	[ -e "$STATE" ] || return 0
	echo "--- fastpath"
	ppacmd getppefpstatus 2>&1
	ppacmd getswfpstatus 2>&1
	echo "--- PAE"; cat /proc/ppa/pae/accel 2>&1
	echo "--- MPE"; cat /proc/ppa/mpe/accel 2>&1
	echo "--- LAN"; ppacmd getlan 2>&1
	echo "--- WAN"; ppacmd getwan 2>&1
	echo "--- sessions"
	ppacmd getlansessionnum 2>&1
	ppacmd getwansessionnum 2>&1
}

case "$1" in
start) start ;;
stop) stop ;;
restart) stop; start ;;
register) register ;;
status) status ;;
*) echo "usage: $0 start|stop|restart|register|status" >&2; exit 1 ;;
esac
