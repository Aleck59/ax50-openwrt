#!/bin/sh /etc/rc.common
# Аппаратное ускорение PPA (GRX350: PAE + MPE + DirectConnect для Wi-Fi).
# Модули ppa_api/ltq_pae_hal/ltq_mpe_hal_drv грузятся при старте, но само
# ускорение включает только `ppacmd init` и регистрация интерфейсов — в стоке
# это делала UGW, в prplWrt этого нет, и весь трафик шёл через процессор.
# Отключить: /etc/init.d/ax50-ppa stop; /etc/init.d/ax50-ppa disable

START=21
STOP=89

WAN_IFS="eth1"
LAN_IFS="br-lan eth0_1 eth0_2 eth0_3 eth0_4"

start() {
	local i
	[ -x /usr/sbin/ppacmd ] || return 0
	grep -q '^ppa_api ' /proc/modules || return 0
	ppacmd init >/dev/null 2>&1 || {
		logger -t ax50-ppa "ppacmd init: ошибка, ускорение выключено"
		return 1
	}
	ppacmd control --enable-lan --enable-wan >/dev/null 2>&1
	for i in $WAN_IFS; do ppacmd addwan -i "$i" >/dev/null 2>&1; done
	for i in $LAN_IFS; do ppacmd addlan -i "$i" >/dev/null 2>&1; done
	# Интерфейсы, поднятые до нас (Wi-Fi, PPPoE); остальные — hotplug
	for i in /sys/class/net/wlan*; do
		[ -e "$i" ] && ppacmd addlan -i "${i##*/}" >/dev/null 2>&1
	done
	for i in /sys/class/net/pppoe-* /sys/class/net/l2tp-*; do
		[ -e "$i" ] && ppacmd addwan -i "${i##*/}" >/dev/null 2>&1
	done
	mkdir -p /var/run && touch /var/run/ax50-ppa
	logger -t ax50-ppa "аппаратное ускорение включено"
}

stop() {
	rm -f /var/run/ax50-ppa
	[ -x /usr/sbin/ppacmd ] && ppacmd exit >/dev/null 2>&1
	return 0
}
