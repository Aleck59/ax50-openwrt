#!/bin/sh /etc/rc.common
# Аппаратное ускорение PPA: настройки /etc/config/ppa («Сеть → Аппаратное
# ускорение» в LuCI), работа — /usr/libexec/ax50-ppa.

START=21
STOP=89
USE_PROCD=1

start_service() {
	/usr/libexec/ax50-ppa start
}

stop_service() {
	/usr/libexec/ax50-ppa stop
}

reload_service() {
	/usr/libexec/ax50-ppa restart
}

service_triggers() {
	procd_add_reload_trigger ppa
}
