# Модули ядра для фида opkg (=m: собираются, но в образ не попадают).
#
# Модули привязаны к конкретной сборке ядра (vermagic), поэтому собираются
# в workflow прошивки вместе с ядром и публикуются как
# <фид>/targets/intel_mips/xrx500/packages. Пакеты из фида, которым они нужны
# (OpenVPN, WireGuard, NFS, модемы...), подтянут их сами.

# --- VPN и туннели ---
CONFIG_PACKAGE_kmod-gre=m
CONFIG_PACKAGE_kmod-l2tp=m
CONFIG_PACKAGE_kmod-pptp=m
CONFIG_PACKAGE_kmod-sit=m
CONFIG_PACKAGE_kmod-ip6-tunnel=m
CONFIG_PACKAGE_kmod-vxlan=m

# --- QoS и межсетевой экран ---
CONFIG_PACKAGE_kmod-ipt-tproxy=m
CONFIG_PACKAGE_kmod-ipt-hashlimit=m
CONFIG_PACKAGE_kmod-ipt-raw=m
CONFIG_PACKAGE_kmod-ipt-u32=m
CONFIG_PACKAGE_kmod-ipt-geoip=m
CONFIG_PACKAGE_kmod-ipt-nflog=m
CONFIG_PACKAGE_kmod-nf-nathelper-extra=m
CONFIG_PACKAGE_kmod-br-netfilter=m

# --- Сеть ---
CONFIG_PACKAGE_kmod-macvlan=m
CONFIG_PACKAGE_kmod-bonding=m
CONFIG_PACKAGE_kmod-veth=m
CONFIG_PACKAGE_kmod-dummy=m

# --- USB-модемы и телефоны (раздача интернета) ---
CONFIG_PACKAGE_kmod-usb-net=m
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=m
CONFIG_PACKAGE_kmod-usb-net-rndis=m
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=m
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=m
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=m
CONFIG_PACKAGE_kmod-usb-net-ipheth=m
CONFIG_PACKAGE_kmod-usb-serial=m
CONFIG_PACKAGE_kmod-usb-serial-option=m
CONFIG_PACKAGE_kmod-usb-acm=m

# --- USB-периферия ---
CONFIG_PACKAGE_kmod-usb-serial-ch341=m
CONFIG_PACKAGE_kmod-usb-serial-cp210x=m
CONFIG_PACKAGE_kmod-usb-serial-ftdi=m
CONFIG_PACKAGE_kmod-usb-serial-pl2303=m
CONFIG_PACKAGE_kmod-usb-printer=m
CONFIG_PACKAGE_kmod-usb-storage-extras=m

# --- Файловые системы ---
CONFIG_PACKAGE_kmod-fs-ntfs=m
CONFIG_PACKAGE_kmod-fs-exfat=m
CONFIG_PACKAGE_kmod-fuse=m
CONFIG_PACKAGE_kmod-fs-btrfs=m
CONFIG_PACKAGE_kmod-fs-f2fs=m
CONFIG_PACKAGE_kmod-fs-xfs=m
CONFIG_PACKAGE_kmod-fs-hfsplus=m
CONFIG_PACKAGE_kmod-fs-isofs=m
CONFIG_PACKAGE_kmod-fs-cifs=m
CONFIG_PACKAGE_kmod-fs-nfs=m
CONFIG_PACKAGE_kmod-fs-nfs-v4=m
CONFIG_PACKAGE_kmod-loop=m

# --- USB: пакеты, зависящие от модулей ядра ---
# SDK собирает пакет, только если доступны его зависимости, а модулей ядра
# в SDK нет (они собираются здесь). Поэтому такие программы — тоже здесь.
# Модемы QMI/MBIM
CONFIG_PACKAGE_kmod-usb-wdm=m
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=m
CONFIG_PACKAGE_uqmi=m
CONFIG_PACKAGE_umbim=m
# USB-сетевые карты (Realtek RTL8152/8153, ASIX)
CONFIG_PACKAGE_kmod-usb-net-rtl8152=m
CONFIG_PACKAGE_kmod-usb-net-asix=m
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=m
# USB по сети (usbip): проброс принтера, ключа, донгла на компьютер
CONFIG_PACKAGE_kmod-usbip=m
CONFIG_PACKAGE_kmod-usbip-client=m
CONFIG_PACKAGE_kmod-usbip-server=m
CONFIG_PACKAGE_usbip=m
CONFIG_PACKAGE_usbip-client=m
CONFIG_PACKAGE_usbip-server=m
# USB-звук
CONFIG_PACKAGE_kmod-sound-core=m
CONFIG_PACKAGE_kmod-usb-audio=m
CONFIG_PACKAGE_alsa-lib=m
CONFIG_PACKAGE_alsa-utils=m
# HID (ИБП, клавиатуры). Веб-камер (kmod-video-uvc) нет: им нужен kmod-dma-buf,
# который OpenWrt не определяет для ядра из git (как у prplWrt)
CONFIG_PACKAGE_kmod-usb-hid=m
# Сетевые папки Windows (монтирование)
CONFIG_PACKAGE_cifsmount=m
