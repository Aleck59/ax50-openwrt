# Прошивка TP-Link Archer AX50 v1 — что попадает в образ.
# Всё остальное ставится через opkg из фида пакетов (config/feed-packages.txt).

# --- Платформа ---------------------------------------------------------------
CONFIG_TARGET_intel_mips=y
CONFIG_TARGET_intel_mips_xrx500=y
CONFIG_TARGET_intel_mips_xrx500_DEVICE_TPLINK_AX50=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_DEVEL=y
CONFIG_KERNEL_GIT_CLONE_URI="https://gitlab.com/prpl-foundation/intel/linux.git"
CONFIG_KERNEL_GIT_REF="727acdb060410a936330a2456f641b9473bf5121"
CONFIG_KERNEL_GIT_DEPTH="1000"
CONFIG_LTQ_SWITCH_CLI_UGW8_HELP_PRINTOUT=y

# OpenSSL — как в профиле prplWrt для RAX40 (на нём собран hostapd)
CONFIG_OPENSSL_ENGINE=y
CONFIG_OPENSSL_WITH_ASM=y
CONFIG_OPENSSL_WITH_CHACHA_POLY1305=y
CONFIG_OPENSSL_PREFER_CHACHA_OVER_GCM=y
CONFIG_OPENSSL_WITH_CMS=y
CONFIG_OPENSSL_WITH_DEPRECATED=y
CONFIG_OPENSSL_WITH_ERROR_MESSAGES=y
CONFIG_OPENSSL_WITH_PSK=y
CONFIG_OPENSSL_WITH_SRP=y
CONFIG_OPENSSL_WITH_TLS13=y

# --- Поддержка платы (калибровка, MAC, порты, светодиоды, Wi-Fi по умолчанию)
CONFIG_PACKAGE_ax50-base-files=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=y
CONFIG_PACKAGE_kmod-ledtrig-netdev=y

# --- Веб-интерфейс -----------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
# Тема footstrap: порт на LuCI 19.07 в работе
# CONFIG_PACKAGE_luci-theme-footstrap=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-app-zapret=y
CONFIG_LUCI_LANG_ru=y
CONFIG_PACKAGE_luci-i18n-base-ru=y
CONFIG_PACKAGE_luci-i18n-firewall-ru=y
CONFIG_PACKAGE_luci-i18n-opkg-ru=y
CONFIG_PACKAGE_luci-i18n-upnp-ru=y

# --- Подключение к провайдеру ------------------------------------------------
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_kmod-pppoe=y

# --- AdGuard Home и zapret ---------------------------------------------------
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_zapret=y

# --- Удобства ----------------------------------------------------------------
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_ip-full=y

# USB-накопители
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y

# Не нужно: wpad/hostapd OpenWrt конфликтуют с hostapd MaxLinear
# CONFIG_PACKAGE_wpad-basic is not set
# CONFIG_PACKAGE_wpad-mini is not set
