irqbalance: опция policyscript (--policyscript)

На GRX350 часть прерываний привязана к ядрам драйверами (очереди CBM
datapath, таймеры ядер). banirq задаёт номера, а они зависят от
загрузки; скрипт политики выбирает прерывания по имени.

--- a/utils/irqbalance/files/irqbalance.init
+++ b/utils/irqbalance/files/irqbalance.init
@@ -29,8 +29,13 @@
 	}
 	config_list_foreach irqbalance banirq handle_banirq_value
 
+	# Скрипт политики (--policyscript): для каждого IRQ печатает ban=true,
+	# чтобы прерывание не переносилось
+	config_get policyscript irqbalance policyscript
+
 	procd_open_instance "irqbalance"
 	procd_set_param command /usr/sbin/irqbalance -f -t "$interval" "$banirq"
+	[ -x "$policyscript" ] && procd_append_param command --policyscript="$policyscript"
 	procd_set_param respawn
 	procd_close_instance
 }
