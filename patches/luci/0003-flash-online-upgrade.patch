+					break;
+				case 'flash':
+					flash();
+					break;
+				case 'error':
+					finish('Ошибка: ' + st.message);
+					break;
+				}
+			}).catch(function() {
+				/* sysupgrade останавливает службы — веб-интерфейс пропадает */
+				flash();
+			});
+		};
+
+		return this.upgradeExec([ 'start', keepSettings ? '1' : '0' ]).then(function(r) {
+			if (!r.started)
+				return finish('Ошибка: ' + (r.error || 'не удалось запустить'));
+			timer = window.setInterval(poll, 1000);
+			poll();
+		});
+	},
