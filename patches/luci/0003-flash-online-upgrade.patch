+	/* ax50-openwrt: обновление из последнего релиза GitHub
+	 * (/usr/libexec/ax50-upgrade: check | start <keep> | status | abort) */
+	upgradeExec: function(args) {
+		return fs.exec('/usr/libexec/ax50-upgrade', args).then(function(res) {
+			try { return JSON.parse(res.stdout || '{}'); }
+			catch (e) { return { error: (res.stderr || res.stdout || 'ax50-upgrade').trim() }; }
+		});
+	},
+
+	handleOnlineCheck: function(ev) {
+		var btn = ev.target;
+		btn.firstChild.data = 'Проверка…';
+
+		return this.upgradeExec([ 'check' ]).then(L.bind(function(r) {
+			if (r.error && !r.latest) {
+				ui.showModal('Обновление из интернета', [
+					E('p', r.error),
+					E('div', { 'class': 'right' }, E('button', { 'class': 'btn', 'click': ui.hideModal }, _('Close')))
+				]);
+				return;
+			}
+
+			var keep = E('input', { type: 'checkbox', checked: true }),
+			    date = r.published ? new Date(r.published).toLocaleDateString() : '',
+			    body = [
+				E('p', [ 'Установлена версия: ', E('strong', r.current || '?') ]),
+				E('p', [ 'Последний релиз: ', E('strong', r.latest), date ? ' (' + date + ')' : '',
+					' — ', E('a', { href: r.url, target: '_blank', rel: 'noreferrer' }, 'описание') ]),
+				r.body ? E('pre', { 'style': 'white-space:pre-wrap;max-height:16em;overflow:auto' }, r.body) : '',
+				r.error ? E('p', { 'class': 'alert-message warning' }, r.error) : '',
+				r.update_available ? E('p', 'Образ скачается в память роутера (%.1f МБ), будет проверен по sha256sums и установлен. Роутер перезагрузится.'.format((r.size || 0) / 1048576))
+					: E('p', 'Установлена последняя версия. Можно переустановить её.'),
+				E('p', E('label', [ keep, ' ', _('Keep settings and retain the current configuration') ]))
+			    ];
+
+			body.push(E('div', { 'class': 'right' }, [
+				E('button', { 'class': 'btn', 'click': ui.hideModal }, _('Cancel')), ' ',
+				E('button', {
+					'class': 'btn cbi-button-action important',
+					'disabled': r.error ? true : null,
+					'click': ui.createHandlerFn(this, 'handleOnlineStart', keep, r)
+				}, (r.update_available ? 'Обновить до ' : 'Переустановить ') + r.latest)
+			]));
+
+			ui.showModal('Обновление из интернета', body);
+		}, this)).finally(function() {
+			btn.firstChild.data = 'Проверить обновление...';
+		});
+	},
+
+	handleOnlineStart: function(keep, rel, ev) {
+		var keepSettings = keep.checked,
+		    text = E('p', { 'class': 'spinning' }, 'Запуск…'),
+		    bar = E('div', { 'class': 'cbi-progressbar', 'title': '0%' }, E('div', { 'style': 'width:0%' })),
+		    abort = E('button', { 'class': 'btn' }, _('Cancel')),
+		    flashing = false, timer = null, view = this;
+
+		ui.showModal('Обновление до ' + rel.latest, [ text, bar, E('div', { 'class': 'right' }, abort) ]);
+
+		var finish = function(msg) {
+			window.clearInterval(timer);
+			ui.showModal('Обновление до ' + rel.latest, [
+				E('p', msg),
+				E('div', { 'class': 'right' }, E('button', { 'class': 'btn', 'click': ui.hideModal }, _('Close')))
+			]);
+		};
+
+		var flash = function() {
+			if (flashing)
+				return;
+			flashing = true;
+			window.clearInterval(timer);
+			ui.showModal(_('Flashing…'), [
+				E('p', { 'class': 'spinning' }, _('The system is flashing now.<br /> DO NOT POWER OFF THE DEVICE!<br /> Wait a few minutes before you try to reconnect. It might be necessary to renew the address of your computer to reach the device again, depending on your settings.'))
