+		abort.addEventListener('click', function() {
+			view.upgradeExec([ 'abort' ]).then(function() { finish('Обновление отменено.'); });
+		});
+
+		var poll = function() {
+			view.upgradeExec([ 'status' ]).then(function(st) {
+				switch (st.stage) {
+				case 'download':
