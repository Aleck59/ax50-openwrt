+					/* ax50-openwrt: возможности WAV600 (Wi-Fi 6). Beamforming и MU
+					 * задаёт служба ax50-wifid командами драйвера, цвет BSS —
+					 * hostapd (patches/feed_wlan_6x/0007). */
+					o = ss.taboption('advanced', form.ListValue, 'ax50_bf_mode', 'Beamforming',
+						'Направленная передача на клиента. «Явный» — по обратной связи от клиента (802.11ac/ax), «неявный» — по оценке канала самой точкой (старые клиенты).');
+					o.value('', 'По умолчанию драйвера (явный)');
+					o.value('auto', 'Автоматически');
+					o.value('explicit', 'Явный (explicit)');
+					o.value('implicit', 'Неявный (implicit)');
+					o.value('off', 'Выключен');
+
+					o = ss.taboption('advanced', form.ListValue, 'ax50_he_mu', 'MU-MIMO и OFDMA (Wi-Fi 6)',
+						'Одновременная передача нескольким клиентам 802.11ax: OFDMA делит канал на части, MU-MIMO — по пространственным потокам. Выключение может помочь со старыми или капризными клиентами.');
+					o.value('', 'По умолчанию драйвера (включено)');
+					o.value('1', 'Включено');
+					o.value('0', 'Выключено');
+
+					o = ss.taboption('advanced', form.Flag, 'mu_beamformer', 'MU-MIMO (Wi-Fi 5)',
